# Azure Container Apps Environment Variables Template
# Copy this file and fill in your actual values

# ===================================
# Azure Infrastructure
# ===================================
AZURE_RESOURCE_GROUP=solo-leveling-rg
AZURE_CONTAINER_APP_ENVIRONMENT=solo-leveling-env
AZURE_CONTAINER_REGISTRY=sololevelingacr.azurecr.io
ACR_USERNAME=<from_azure_portal>
ACR_PASSWORD=<from_azure_portal>

# ===================================
# MongoDB Configuration
# ===================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=<generate_strong_password>
MONGO_INITDB_DATABASE=solo_leveling

# Connection string for internal Azure Container Apps networking
# Format: mongodb://username:password@hostname:port/database?authSource=admin
MONGODB_URL=mongodb://admin:<MONGO_ROOT_PASSWORD>@solo-leveling-mongodb:27017/solo_leveling?authSource=admin

# ===================================
# Authentication & Security
# ===================================
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=<generate_32_char_hex>

# Your deployed application URL
NEXTAUTH_URL=https://<your-app-name>.azurecontainerapps.io

# ===================================
# OAuth Providers
# ===================================
# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>

# ===================================
# External APIs
# ===================================
# NewsAPI.org (https://newsapi.org/account)
NEWS_API_KEY=<your_newsapi_key>

# ===================================
# Next.js Configuration
# ===================================
# Public URL for client-side API calls
NEXT_PUBLIC_FASTAPI_URL=https://<fastapi-container-app-name>.azurecontainerapps.io

# Internal URL for server-side API calls (Container Apps networking)
FASTAPI_SERVICE_URL=https://solo-leveling-fastapi.internal.<env-name>.azurecontainerapps.io

# ===================================
# Azure Service Principal (for GitHub Actions)
# ===================================
# Generate with:
# az ad sp create-for-rbac --name "solo-leveling-github-actions" \
#   --role contributor \
#   --scopes /subscriptions/<subscription-id>/resourceGroups/solo-leveling-rg \
#   --sdk-auth

AZURE_CREDENTIALS='{
  "clientId": "<service-principal-client-id>",
  "clientSecret": "<service-principal-secret>",
  "subscriptionId": "<azure-subscription-id>",
  "tenantId": "<azure-tenant-id>",
  "activeDirectoryEndpointUrl": "https://login.microsoftonline.com",
  "resourceManagerEndpointUrl": "https://management.azure.com/",
  "activeDirectoryGraphResourceId": "https://graph.windows.net/",
  "sqlManagementEndpointUrl": "https://management.core.windows.net:8443/",
  "galleryEndpointUrl": "https://gallery.azure.com/",
  "managementEndpointUrl": "https://management.core.windows.net/"
}'

# ===================================
# Optional: Azure Monitor
# ===================================
APPLICATIONINSIGHTS_CONNECTION_STRING=<from_azure_portal>

# ===================================
# Generation Commands
# ===================================
# Run these commands to generate secure values:
#
# Generate NEXTAUTH_SECRET:
#   openssl rand -hex 32
#
# Generate strong password:
#   openssl rand -base64 24
#
# Get Azure credentials:
#   az acr credential show --name sololevelingacr
#
# Create service principal:
#   az ad sp create-for-rbac --name "solo-leveling-github" \
#     --role contributor \
#     --scopes /subscriptions/$(az account show --query id -o tsv)/resourceGroups/solo-leveling-rg \
#     --sdk-auth
