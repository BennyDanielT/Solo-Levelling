{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "15367835724200947576"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "The location where resources will be deployed."
      }
    },
    "elasticLocation": {
      "type": "string",
      "defaultValue": "canadacentral",
      "metadata": {
        "description": "The location where the Elasticsearch monitor will be deployed. Must be a supported region."
      }
    },
    "containerAppEnvName": {
      "type": "string",
      "defaultValue": "solo-leveling-env",
      "metadata": {
        "description": "The name of the Azure Container Apps Environment."
      }
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "defaultValue": "solo-leveling-logs",
      "metadata": {
        "description": "The name of the Log Analytics Workspace."
      }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "[format('sololevelingkv-{0}', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "The name of the Azure Key Vault for secrets management."
      }
    },
    "elasticMonitorName": {
      "type": "string",
      "defaultValue": "solo-leveling-elastic-monitor",
      "metadata": {
        "description": "The name of the managed Elasticsearch resource."
      }
    },
    "adminEmail": {
      "type": "string",
      "defaultValue": "benny28dany@gmail.com",
      "metadata": {
        "description": "The email address associated with the Elastic owner/administrator."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[parameters('logAnalyticsWorkspaceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('containerAppEnvName')]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName')), '2022-10-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName')), '2022-10-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]"
      ]
    },
    {
      "type": "Microsoft.Elastic/monitors",
      "apiVersion": "2024-03-01",
      "name": "[parameters('elasticMonitorName')]",
      "location": "[parameters('elasticLocation')]",
      "sku": {
        "name": "ess-monthly-consumption_Monthly"
      },
      "properties": {
        "userInfo": {
          "emailAddress": "[parameters('adminEmail')]"
        }
      }
    },
    {
      "type": "Microsoft.Elastic/monitors/tagRules",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', parameters('elasticMonitorName'), 'default')]",
      "properties": {
        "logRules": {
          "sendActivityLogs": true,
          "sendAadLogs": false,
          "sendSubscriptionLogs": true,
          "filteringTags": [
            {
              "name": "environment",
              "value": "production",
              "action": "Include"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Elastic/monitors', parameters('elasticMonitorName'))]"
      ]
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "enabledForDeployment": true,
        "enabledForTemplateDeployment": true,
        "enabledForDiskEncryption": false,
        "tenantId": "[subscription().tenantId]",
        "accessPolicies": [],
        "sku": {
          "name": "standard",
          "family": "A"
        }
      }
    }
  ],
  "outputs": {
    "elasticsearchEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Elastic/monitors', parameters('elasticMonitorName')), '2024-03-01').elasticProperties.elasticCloudDeployment.elasticsearchServiceUrl]"
    },
    "kibanaEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Elastic/monitors', parameters('elasticMonitorName')), '2024-03-01').elasticProperties.elasticCloudDeployment.kibanaServiceUrl]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri]"
    }
  }
}