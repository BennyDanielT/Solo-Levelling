# Environment Variables for Solo Leveling App
# Copy this file to .env.local (or .env) and replace placeholders with real values
# Keep secrets out of version control

# NextAuth Configuration
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Required for Google Sign-In)
# Get these from: https://console.cloud.google.com/
# Redirect URI example: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# GitHub OAuth (Optional)
# Get these from: https://github.com/settings/developers
GITHUB_ID=your-github-client-id-here
GITHUB_SECRET=your-github-client-secret-here

# Database Configuration
# MongoDB connection string (for local development and Docker)
DATABASE_URL=mongodb://localhost:27017/solo_levelling

# Docker MongoDB credentials
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=your-mongo-password-here

# FastAPI Backend URL
FASTAPI_SERVICE_URL=http://localhost:8000

# Bcrypt rounds for password hashing (handled in FastAPI now)
BCRYPT_ROUNDS=12

# Development Environment
NODE_ENV=development

# Azure AI / Foundry / Project settings
AZURE_AI_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project-name>
AZURE_EXISTING_AGENT_ID=asst_xxx
AZURE_ENV_NAME=your-azure-env-name
AZURE_LOCATION=your-azure-location
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id

# Project-specific endpoint (preferred)
# Example format: https://<your-resource>.services.ai.azure.com/api/projects/<project-name>
AZURE_EXISTING_AIPROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<project-name>

# Resource IDs (optional, for automation/scripts)
AZURE_EXISTING_AIPROJECT_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
AZURE_EXISTING_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>

# Allow AZD to scaffold into non-empty folders (optional)
AZD_ALLOW_NON_EMPTY_FOLDER=your-boolean-value (true or false)

# Inference / API key (copy from Azure Portal or CLI)
# - If using AzureKeyCredential or API key, set AZURE_INFERENCE_CREDENTIAL to the key.
# - If using DefaultAzureCredential, authenticate via az login or set service principal vars below.
AZURE_INFERENCE_CREDENTIAL=your-azure-inference-key-here

# Optional: service principal creds for DefaultAzureCredential (if using service principal)
AZURE_CLIENT_ID=your-azure-client-id
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_SECRET=your-azure-client-