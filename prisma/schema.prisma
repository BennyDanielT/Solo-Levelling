// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  // url removed for Prisma v7+; supply connection info via prisma.config.ts or PrismaClient constructor
}

// NextAuth.js required collections (MongoDB)
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Registered Users Collection
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  username      String?   @unique
  password      String?   // For email/password authentication
  
  // Platform tracking
  loginPlatform String    @default("email") // "google", "github", "email"
  platformId    String?   // Store platform-specific ID if needed
  
  // Solo Leveling specific fields
  level         Int       @default(1)
  totalPoints   Int       @default(0)
  rank          String    @default("E")
  title         String    @default("Awakened Hunter")
  joinedAt      DateTime  @default(now())
  lastActive    DateTime  @default(now())
  
  // User preferences
  preferences   Json?     // Store user settings as JSON
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  goals         Goal[]
  achievements  Achievement[]
  
  @@map("users")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Goals Collection
model Goal {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  weight      Float     // percentage weight (0-100)
  points      Int       // points awarded when completed
  completed   Boolean   @default(false)
  archived    Boolean   @default(false)
  difficulty  String    // "easy", "medium", "hard"
  
  // Goal metadata
  category    String?   // "personal", "work", "health", etc.
  priority    String    @default("medium") // "low", "medium", "high"
  tags        String[]  // Array of tags for organization
  
  // Timestamps
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  
  // Relations
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("goals")
}

// Achievements/Accomplishments Collection
model Achievement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  type        String   // "companion" or "item"
  name        String
  description String?
  iconPath    String?
  
  // Achievement metadata
  rarity      String   @default("common") // "common", "rare", "epic", "legendary"
  category    String?  // "combat", "exploration", "social", etc.
  source      String?  // How it was earned: "goal_completion", "points_milestone", etc.
  
  // Requirements and rewards
  pointsRequired Int
  requirements   Json? // Store complex requirements as JSON
  rewards        Json? // Store rewards/bonuses as JSON
  
  // Timestamps
  unlockedAt  DateTime @default(now())
  
  // Relations
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("achievements")
}
